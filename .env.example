HIVEMIND_APP_ENV=development
HIVEMIND_DATABASE_URL=postgresql+asyncpg://hivemind:hivemind@localhost:5432/hivemind
HIVEMIND_DATABASE_ECHO=false

# Runway login. Set MOCK_MODE=false to use real Playwright login.
# Credentials below MUST stay in .env (gitignored) — never commit them.
HIVEMIND_RUNWAY_MOCK_MODE=true
HIVEMIND_RUNWAY_EMAIL=
HIVEMIND_RUNWAY_PASSWORD=
HIVEMIND_RUNWAY_LOGIN_URL=https://app.runwayml.com/login
HIVEMIND_RUNWAY_DASHBOARD_URL_PREFIX=https://app.runwayml.com/
HIVEMIND_RUNWAY_PLAYWRIGHT_HEADLESS=true
HIVEMIND_RUNWAY_PLAYWRIGHT_TIMEOUT_MS=30000

# Runway Developer API (official). Get a key at https://dev.runwayml.com
# When set, video-mode generations with a reference image are submitted to
# the real API. Each generation costs Runway credits from your account.
HIVEMIND_RUNWAY_API_KEY=
HIVEMIND_RUNWAY_API_BASE_URL=https://api.dev.runwayml.com/v1
HIVEMIND_RUNWAY_API_VERSION=2024-11-06
HIVEMIND_RUNWAY_DEFAULT_VIDEO_MODEL=gen3a_turbo
HIVEMIND_RUNWAY_DEFAULT_DURATION_S=5

# Which backend drives GenerationService. One of:
#   mock     - SVG placeholder (safe default).
#   api      - official Runway Developer API (requires runway_api_key).
#   scraper  - Playwright drives app.runwayml.com (FRAGILE, ToS risk).
HIVEMIND_RUNWAY_BACKEND=mock

# Scraper: your team slug (from URL app.runwayml.com/.../teams/<SLUG>/...).
HIVEMIND_RUNWAY_TEAM_SLUG=
HIVEMIND_RUNWAY_SCRAPER_TIMEOUT_MS=120000
HIVEMIND_RUNWAY_SCRAPER_RESULT_WAIT_MS=180000
